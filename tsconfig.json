{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/renderer/**/*.ts",
    "packages/renderer/**/*.tsx",
    "packages/api/**/*.ts",
    "packages/counter/**/*.ts",
    "infra/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/cdk.out", "**/dist"]
}
